<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="26dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title"
                style="@style/Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/subtitle"
                style="@style/Subtitle" />

            <TextView
                android:id="@+id/pc_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:drawableEnd="@drawable/ic_refresh"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/pc_checking"
                style="@style/Subtitle" />
        </LinearLayout>

        <!-- Мониторинг нагрузки -->
        <LinearLayout
            android:id="@+id/monitor_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:elevation="1.5dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    style="@style/SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sec_monitor" />

                <TextView
                    android:id="@+id/monitor_updated"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/mon_cpu"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/mon_cpu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mon_na"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/bar_cpu"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/meter" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/mon_ram"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/mon_ram"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mon_na"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/bar_ram"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/meter" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/mon_gpu"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/mon_gpu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mon_na"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/bar_gpu"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/meter_green" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/mon_vram"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/mon_vram"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mon_na"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/bar_vram"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/meter_green" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Карточка настроек -->
        <LinearLayout
            android:id="@+id/card_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp"
            android:elevation="1.5dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sec_conn"
                style="@style/SectionLabel" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/lbl_mac"
                style="@style/Subtitle" />

            <EditText
                android:id="@+id/edit_mac"
                style="@style/Field"
                android:layout_marginTop="4dp"
                android:hint="@string/hint_mac"
                android:inputType="textNoSuggestions"
                android:digits="0123456789abcdefABCDEF:-." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_bcast"
                style="@style/Subtitle" />

            <EditText
                android:id="@+id/edit_bcast"
                style="@style/Field"
                android:layout_marginTop="4dp"
                android:hint="@string/hint_bcast"
                android:inputType="textNoSuggestions"
                android:digits="0123456789.:" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_host"
                style="@style/Subtitle" />

            <EditText
                android:id="@+id/edit_host"
                style="@style/Field"
                android:layout_marginTop="4dp"
                android:hint="@string/hint_host"
                android:inputType="textNoSuggestions"
                android:digits="0123456789.:" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_key"
                style="@style/Subtitle" />

            <EditText
                android:id="@+id/edit_key"
                style="@style/Field"
                android:layout_marginTop="4dp"
                android:hint="@string/hint_key"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btn_save"
                style="@style/BtnOutline"
                android:layout_marginTop="4dp"
                android:text="@string/btn_save" />
        </LinearLayout>

        <!-- Кнопки управления -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sec_buttons"
            style="@style/SectionLabel" />

        <Button
            android:id="@+id/btn_on"
            style="@style/BtnWake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:drawableStart="@drawable/ic_power_on"
            android:drawablePadding="12dp"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:gravity="center"
            android:textColor="@color/wake_text"
            android:text="@string/btn_on" />

        <Button
            android:id="@+id/btn_off"
            style="@style/BtnDanger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:drawableStart="@drawable/ic_power_off"
            android:drawablePadding="12dp"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:gravity="center"
            android:textColor="@color/on_danger"
            android:text="@string/btn_off" />

        <Button
            android:id="@+id/btn_restart"
            style="@style/BtnOutline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:drawableStart="@drawable/ic_restart"
            android:drawablePadding="12dp"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:gravity="center"
            android:text="@string/btn_restart" />

        <Button
            android:id="@+id/btn_lock"
            style="@style/BtnOutline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="12dp"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:gravity="center"
            android:text="@string/btn_lock" />

        <Button
            android:id="@+id/btn_screen"
            style="@style/BtnOutline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:drawableStart="@drawable/ic_screen"
            android:drawablePadding="12dp"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:gravity="center"
            android:text="@string/btn_screen" />

        <Button
            android:id="@+id/btn_view"
            style="@style/BtnOutline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:drawableStart="@drawable/ic_eye"
            android:drawablePadding="12dp"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:gravity="center"
            android:text="@string/btn_view" />

        <Button
            android:id="@+id/btn_mirror"
            style="@style/BtnOutline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:drawableStart="@drawable/ic_cast"
            android:drawablePadding="12dp"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:gravity="center"
            android:text="@string/btn_mirror" />

        <Button
            android:id="@+id/btn_upload"
            style="@style/BtnOutline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:drawableStart="@drawable/ic_upload"
            android:drawablePadding="12dp"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:gravity="center"
            android:text="@string/upload_title" />

        <Button
            android:id="@+id/btn_cancel"
            style="@style/BtnOutline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:drawableStart="@drawable/ic_undo"
            android:drawablePadding="12dp"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:gravity="center"
            android:visibility="gone"
            android:text="@string/btn_cancel" />

        <Button
            android:id="@+id/btn_theme"
            style="@style/BtnOutline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:drawableStart="@drawable/ic_theme"
            android:drawablePadding="12dp"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:gravity="center"
            android:text="@string/theme_auto" />

        <!-- Быстрые команды -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sec_actions"
            style="@style/SectionLabel" />

        <LinearLayout
            android:id="@+id/actions_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Плитки приложений -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sec_apps"
            style="@style/SectionLabel" />

        <LinearLayout
            android:id="@+id/apps_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/hint_close"
            style="@style/Subtitle" />

        <!-- Журнал -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sec_log"
            style="@style/SectionLabel" />

        <TextView
            android:id="@+id/status_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/status_bg"
            android:elevation="1dp"
            android:padding="16dp"
            android:minLines="4"
            android:text="@string/status_idle"
            style="@style/StatusText" />
    </LinearLayout>
</ScrollView>
