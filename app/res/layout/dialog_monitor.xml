<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dlg_monitor"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/db_text_primary" />

    <TextView
        android:id="@+id/dlg_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="?attr/db_text_secondary" />

    <TextView
        android:id="@+id/dlg_offline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/mon_pc_offline"
        android:textSize="13sp"
        android:textColor="?attr/db_text_secondary"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mon_cpu"
            android:textSize="13sp"
            android:textColor="?attr/db_text_secondary" />

        <TextView
            android:id="@+id/dlg_cpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mon_na"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/db_text_primary" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/dlg_bar_cpu"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/meter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mon_ram"
            android:textSize="13sp"
            android:textColor="?attr/db_text_secondary" />

        <TextView
            android:id="@+id/dlg_ram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mon_na"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/db_text_primary" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/dlg_bar_ram"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/meter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mon_gpu"
            android:textSize="13sp"
            android:textColor="?attr/db_text_secondary" />

        <TextView
            android:id="@+id/dlg_gpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mon_na"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/db_text_primary" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/dlg_bar_gpu"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/meter_green" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mon_vram"
            android:textSize="13sp"
            android:textColor="?attr/db_text_secondary" />

        <TextView
            android:id="@+id/dlg_vram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mon_na"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/db_text_primary" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/dlg_bar_vram"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/meter_green" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="?attr/db_card_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dlg_gpu_name"
            android:textSize="13sp"
            android:textColor="?attr/db_text_secondary" />

        <TextView
            android:id="@+id/dlg_gpu_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mon_na"
            android:textSize="13sp"
            android:textColor="?attr/db_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dlg_gpu_temp"
            android:textSize="13sp"
            android:textColor="?attr/db_text_secondary" />

        <TextView
            android:id="@+id/dlg_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mon_na"
            android:textSize="13sp"
            android:textColor="?attr/db_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dlg_uptime"
            android:textSize="13sp"
            android:textColor="?attr/db_text_secondary" />

        <TextView
            android:id="@+id/dlg_uptime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mon_na"
            android:textSize="13sp"
            android:textColor="?attr/db_text_primary" />
    </LinearLayout>

    <Button
        android:id="@+id/dlg_refresh"
        style="@style/BtnOutline"
        android:layout_marginTop="16dp"
        android:text="@string/dlg_refresh" />
</LinearLayout>
