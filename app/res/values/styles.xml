<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Material берём из framework (Theme.Material.*): он есть начиная с API 21,
       поэтому тема гарантированно заведётся на любом телефоне из диапазона поддержки.
       Ночной вариант — в values-night/styles.xml, там тот же имя но тёмная база.
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/window_bg</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/bg_screen</item>
        <item name="android:navigationBarColor">@color/bg_screen</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:buttonStyle">@style/AppButton</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
    </style>

    <!-- Окно просмотра экрана: всегда тёмное, без мигания при светлой теме. -->
    <style name="ScreenTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:buttonStyle">@style/BtnToolbar</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:colorAccent">@color/primary</item>
    </style>

    <style name="Title">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Subtitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="SectionLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="Field">
        <item name="android:textSize">15sp</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Native API-21 Button base. Clear framework tint before using our ripple. -->
    <style name="AppButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textColor">@color/button_outline_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="BtnFilled" parent="AppButton">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/btn_filled</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="BtnDanger" parent="BtnFilled">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">@color/button_danger_text</item>
    </style>

    <style name="BtnWake" parent="BtnFilled">
        <item name="android:background">@drawable/btn_wake</item>
        <item name="android:textColor">@color/button_wake_text</item>
    </style>

    <style name="BtnOutline" parent="BtnFilled">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/button_outline_text</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="BtnDialog" parent="AppButton">
        <item name="android:background">@drawable/btn_flat</item>
    </style>

    <!-- Video controls stay legible regardless of the application's day/night mode. -->
    <style name="BtnToolbar" parent="AppButton">
        <item name="android:background">@drawable/btn_toolbar</item>
        <item name="android:textColor">@color/button_toolbar_label</item>
    </style>

    <style name="StatusText">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- App-owned dialogs only; OS permission/installer UI uses its own theme. -->
    <style name="AppDialogTheme" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:buttonStyle">@style/AppButton</item>
        <item name="android:buttonBarButtonStyle">@style/BtnDialog</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/BtnDialog</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/BtnDialog</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/BtnDialog</item>
    </style>
</resources>
