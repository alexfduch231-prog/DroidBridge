<?xml version="1.0" encoding="utf-8"?>
<!-- Android 13+ (API 33): themed icons. Лаунчер берёт monochrome-слой и красит
     его под текущую тему Material You. На 8-12 этот файл не читается, там
     обычный adaptive-icon из mipmap-anydpi-v26. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_bg" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
